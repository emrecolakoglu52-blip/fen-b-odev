rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ödev kaydının geçerli olup olmadığını kontrol eder.
    function valid(d) {
      return d.keys().hasOnly(['title', 'subject', 'desc', 'author', 'due', 'photo', 'createdAt', 'uid'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 20
        && d.desc is string && d.desc.size() <= 1000
        && d.author is string && d.author.size() > 0 && d.author.size() <= 40
        && d.due is string && d.due.size() == 10
        && d.photo is string && d.photo.size() <= 200000
        && d.createdAt is number
        && d.uid is string;
    }

    match /homework/{id} {
      // Herkes ödevleri görebilir.
      allow read: if true;
      // Giriş yapmış (gizli kimlikli) herkes ödev ekleyebilir.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && valid(request.resource.data);
      // Sadece ödevi ekleyen kişi düzenleyebilir veya silebilir.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && valid(request.resource.data);
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
